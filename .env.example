APP_NAME="Foco Hotel API"
APP_ENV=local
APP_KEY=
# Mesmo com true, a API nunca devolve stack trace/SQL nas respostas de erro (só a página web).
APP_DEBUG=false
APP_TIMEZONE=America/Bahia
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Docker: DB_HOST=mysql | Local: DB_HOST=127.0.0.1
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=foco_hotel
DB_USERNAME=foco
DB_PASSWORD=secret

SESSION_DRIVER=file
# Cache no banco: compartilhado entre os containers (rate limit, idempotência, travas do cron)
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Importação de XML (cron)
XML_IMPORT_PATH=
XML_IMPORT_CRON="0 * * * *"

# Pagamentos
PAYMENT_INTEREST_FREE_INSTALLMENTS=3
PAYMENT_MONTHLY_INTEREST_PERCENT=1.99

# Validade (horas) do token de acesso da API
API_TOKEN_TTL_HOURS=8

# Pré-reserva online (sem login e sem pagamento): horas até liberar o quarto. 0 desativa.
RESERVE_PENDING_TTL_HOURS=24

# Atrás de balanceador/proxy reverso: IPs do proxy separados por vírgula (ou *), para os
# limites de requisição usarem o IP real do cliente.
TRUSTED_PROXIES=

# Origens autorizadas a chamar a API pelo navegador (CORS), separadas por vírgula.
CORS_ALLOWED_ORIGINS=*

# E-mail de confirmação ao hóspede. "log" grava o e-mail em storage/logs (ideal para avaliação);
# em produção use smtp/ses/postmark com as credenciais do provedor.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="reservas@foco.test"
MAIL_FROM_NAME="${APP_NAME}"
